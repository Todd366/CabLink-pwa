# Required in production
NODE_ENV=production
ADMIN_KEY=             # 16+ random characters. The API refuses admin-key access without it.
CORS_ORIGINS=          # leave empty for same-origin (recommended on Vercel)
# Durable storage (Vercel has no permanent disk)
CABLINK_ACCOUNT_PERSISTENCE=SUPABASE
CABLINK_RIDE_PERSISTENCE=SUPABASE
# Optional
FUEL_PRICE_BWP=14.8
