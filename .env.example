VITE_CABLINK_API_URL=https://your-backend-domain.com
CABLINK_API_URL=https://your-backend-domain.com
NODE_ENV=production

# ============================================================
# PERSISTENCE
# ============================================================
# LOCAL (default) = flat JSON file. Do NOT use this on Vercel —
#   serverless functions have no persistent disk; rides will be
#   lost between invocations.
# SUPABASE = recommended for production on free-tier Vercel.
# FIRESTORE = alternative, requires firebase-admin credentials.
CABLINK_RIDE_PERSISTENCE=SUPABASE

# Required if CABLINK_RIDE_PERSISTENCE=SUPABASE
# Get these from Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# THOBOCOIN / BSC TESTNET
# ============================================================
# ROTATE THIS if you have not already — see
# scripts/rotate_treasury_wallet.js
PRIVATE_KEY=
TREASURY_WALLET=
CONTRACT_ADDRESS=
RPC_URL=
