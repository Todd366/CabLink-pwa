const express = require("express");

const app = express();

app.use(express.json());

const COLLECTION =
    "cablink_test_rides";

console.log(
    "============================================================"
);

console.log(
    "CABLINK TEST O.2: FIRESTORE RAW OPERATION DIAGNOSTIC"
);

console.log(
    "============================================================"
);


// ============================================================
// FIRESTORE RAW OPERATION TEST
// ============================================================

app.get(
    "/api/firestore-operation-diagnostic",
    async (req, res) => {

        const result = {

            success:
                false,

            test:
                "FIRESTORE_RAW_OPERATION_DIAGNOSTIC",

            timestamp:
                new Date().toISOString(),

            steps: {}

        };


        // ====================================================
        // STEP 1 — LOAD DATABASE ADAPTER
        // ====================================================

        let db;

        try {

            db =
                require(
                    "../backend/production/database_adapter"
                );

            result.steps.adapterLoad = {

                success:
                    true,

                exports:
                    Object.keys(db),

                provider:
                    db.provider()

            };

        } catch (error) {

            result.steps.adapterLoad = {

                success:
                    false,

                name:
                    error.name,

                code:
                    error.code,

                message:
                    error.message,

                stack:
                    error.stack

            };

            return res
                .status(500)
                .json(result);

        }


        // ====================================================
        // STEP 2 — VERIFY PROVIDER
        // ====================================================

        try {

            const provider =
                db.provider();

            result.steps.provider = {

                success:
                    true,

                provider:
                    provider

            };

        } catch (error) {

            result.steps.provider = {

                success:
                    false,

                name:
                    error.name,

                code:
                    error.code,

                message:
                    error.message,

                stack:
                    error.stack

            };

            return res
                .status(500)
                .json(result);

        }


        // ====================================================
        // STEP 3 — GENERATE TEST DOCUMENT
        // ====================================================

        const documentId =
            "O2-RAW-TEST-" +
            Date.now();

        const testDocument = {

            id:
                documentId,

            test:
                "FIRESTORE_RAW_OPERATION_DIAGNOSTIC",

            createdAt:
                new Date().toISOString(),

            payload: {

                pickup:
                    "BSTM HQ",

                dropoff:
                    "Game City Mall",

                fare:
                    20,

                passenger:
                    "O2-TEST-PASSENGER"

            }

        };


        result.document = {

            collection:
                COLLECTION,

            id:
                documentId

        };


        // ====================================================
        // STEP 4 — WRITE DOCUMENT
        // ====================================================

        try {

            const writeResult =
                await db.write(
                    COLLECTION,
                    documentId,
                    testDocument
                );

            result.steps.write = {

                success:
                    true,

                result:
                    writeResult

            };

        } catch (error) {

            result.steps.write = {

                success:
                    false,

                name:
                    error.name,

                code:
                    error.code,

                message:
                    error.message,

                stack:
                    error.stack

            };

            return res
                .status(500)
                .json(result);

        }


        // ====================================================
        // STEP 5 — READ DOCUMENT
        // ====================================================

        let readResult;

        try {

            readResult =
                await db.read(
                    COLLECTION,
                    documentId
                );

            result.steps.read = {

                success:
                    true,

                result:
                    readResult

            };

        } catch (error) {

            result.steps.read = {

                success:
                    false,

                name:
                    error.name,

                code:
                    error.code,

                message:
                    error.message,

                stack:
                    error.stack

            };

            return res
                .status(500)
                .json(result);

        }


        // ====================================================
        // STEP 6 — VERIFY DOCUMENT EXISTS
        // ====================================================

        try {

            const exists =
                Boolean(
                    readResult &&
                    readResult.exists
                );

            const dataMatches =
                JSON.stringify(
                    readResult &&
                    readResult.data
                ) ===
                JSON.stringify(
                    testDocument
                );

            result.steps.verification = {

                success:
                    exists &&
                    dataMatches,

                exists:
                    exists,

                dataMatches:
                    dataMatches,

                returnedData:
                    readResult &&
                    readResult.data

            };

        } catch (error) {

            result.steps.verification = {

                success:
                    false,

                name:
                    error.name,

                code:
                    error.code,

                message:
                    error.message,

                stack:
                    error.stack

            };

        }


        // ====================================================
        // FINAL RESULT
        // ============================================================

        const writePassed =
            result.steps.write &&
            result.steps.write.success === true;

        const readPassed =
            result.steps.read &&
            result.steps.read.success === true;

        const verificationPassed =
            result.steps.verification &&
            result.steps.verification.success === true;

        result.success =
            writePassed &&
            readPassed &&
            verificationPassed;

        result.overall = {

            write:
                writePassed,

            read:
                readPassed,

            persistence:
                verificationPassed,

            final:
                result.success

        };


        /*
         * IMPORTANT:
         *
         * This test intentionally does NOT delete the document
         * because the current adapter exposes only:
         *
         * write()
         * read()
         *
         * No delete() operation exists.
         *
         * The test document is isolated inside:
         *
         * cablink_test_rides
         *
         * and has the prefix:
         *
         * O2-RAW-TEST-
         */

        result.cleanup = {

            attempted:
                false,

            reason:
                "DELETE_OPERATION_NOT_EXPOSED_BY_CURRENT_ADAPTER",

            collection:
                COLLECTION,

            documentId:
                documentId

        };


        return res
            .status(
                result.success
                    ? 200
                    : 500
            )
            .json(result);

    }
);


// ============================================================
// BASIC HEALTH
// ============================================================

app.get(
    "/api/health",
    (req, res) => {

        res.json({

            system:
                "CabLink API",

            status:
                "ONLINE",

            test:
                "FIRESTORE_RAW_OPERATION_DIAGNOSTIC",

            time:
                new Date().toISOString()

        });

    }
);


module.exports =
    app;
