const express = require("express");

const app =
    express();

app.use(
    express.json()
);

console.log(
    "CABLINK TEST L: Real Firestore persistence"
);

app.get(
    "/api/health",
    (req, res) => {

        res.json({

            system:
                "CabLink API",

            status:
                "ONLINE",

            test:
                "REAL_FIRESTORE_PERSISTENCE",

            time:
                new Date().toISOString()

        });

    }
);

app.get(
    "/api/firestore-status",
    (req, res) => {

        try {

            const firestore =
                require(
                    "../backend/firebase/firestore_adapter"
                );

            res.json({

                success:
                    true,

                status:
                    firestore.status()

            });

        } catch (error) {

            res
                .status(500)
                .json({

                    success:
                        false,

                    error:
                        error.message,

                    stack:
                        error.stack

                });

        }

    }
);

app.post(
    "/api/firestore-test",
    async (req, res) => {

        const firestore =
            require(
                "../backend/firebase/firestore_adapter"
            );

        const id =
            "CABLINK-TEST-" +
            Date.now();

        const testData = {

            test:
                true,

            system:
                "CabLink",

            message:
                "Real Firestore persistence test",

            created:
                new Date().toISOString()

        };

        try {

            console.log(
                "TEST L: Writing document",
                id
            );

            const writeResult =
                await firestore.write(
                    "cablink_persistence_tests",
                    id,
                    testData
                );

            console.log(
                "TEST L: Reading document",
                id
            );

            const readResult =
                await firestore.read(
                    "cablink_persistence_tests",
                    id
                );

            res.json({

                success:
                    true,

                test:
                    "REAL_FIRESTORE_PERSISTENCE",

                write:
                    writeResult,

                read:
                    readResult,

                readAfterWrite:
                    readResult.exists === true

            });

        } catch (error) {

            console.error(
                "TEST L FIRESTORE FAILURE"
            );

            console.error(
                error.stack || error
            );

            res
                .status(500)
                .json({

                    success:
                        false,

                    test:
                        "REAL_FIRESTORE_PERSISTENCE",

                    error: {

                        name:
                            error.name,

                        code:
                            error.code,

                        message:
                            error.message,

                        stack:
                            error.stack

                    }

                });

        }

    }
);

module.exports =
    app;
